# ---------------------------------------------------------------------------
# SoccerX Camp email delivery
# ---------------------------------------------------------------------------
#
# Example configuration only.
# Never commit real SMTP usernames, passwords, or other secrets.
#
# Port 465:
#   SMTP_SECURE=true
#
# Port 587 / STARTTLS:
#   SMTP_SECURE=false
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=administrator@example.com
SMTP_PASSWORD=replace-with-a-secret

SMTP_FROM_EMAIL=administrator@example.com
SMTP_FROM_NAME=SoccerX Camp

# Comma-separated recipient addresses are supported by Nodemailer.
CONTACT_TO_EMAIL=contact@example.com
PARTICIPATION_TO_EMAIL=participation@example.com